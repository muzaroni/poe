---
import '../styles/global.css';
import HeaderSearch from '../components/HeaderSearch';
import GemInfo from '../components/GemInfo';
import SocialLinks from '../components/SocialLinks.astro';
import Analytics from '../components/Analytics.astro';
const { title, description = 'Visual Path of Exile build guides' } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090c" />
    <meta name="description" content={description} />
    <title>{title} · Muzaroni PoE</title>
    <Analytics />
  </head>
  <body>
    <header class="site-header"><div class="shell header-inner"><a class="brand" href={base}><img class="brand-logo" src={`${base}images/branding/muzdevoto.gif`} alt="" width="64" height="64" /><span>MUZARONI <small>PATH OF EXILE GUIDES</small></span></a><HeaderSearch base={base} client:load /></div></header>
    <slot />
    <GemInfo client:load />
    <footer class="site-footer"><div class="shell"><div class="mobile-social-links"><SocialLinks /></div>Fan made Path of Exile guides. Not affiliated with Grinding Gear Games.</div></footer>
  </body>
</html>

