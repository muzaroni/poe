  <a class="social-profile" href="https://www.youtube.com/@muzmuz" target="_blank" rel="noopener noreferrer"><img src={`${base}images/social/youtube.svg`} width="20" height="20" alt="YouTube" /><span>@muzmuz</span></a>
</div>
