---
import example from '../data/tree-inline-example.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import TreeSnapshotDemo from '../components/TreeSnapshotDemo';
import stages from '../../public/data/trees/sunder-rf-stages.json';
import type { TreeStage } from '../lib/passive-tree';
const exampleStages = stages.stages as unknown as TreeStage[];
import { normalizeSnapshot, respecBaseline } from '../lib/tree-snapshot';
const snapshot = normalizeSnapshot(example);
const respecBefore = normalizeSnapshot({ ...exampleStages.find(stage => stage.title === '55 pre-swap'), title: 'Level 55 · before RF swap', version: '3.28.0' });
const respecAfter = normalizeSnapshot({ ...exampleStages.find(stage => stage.title === '55 post-swap'), title: 'RF swap respec', version: '3.28.0', width: 600, height: 360, respec: { ...respecBaseline(respecBefore), note: 'Check your available quest refunds before using gold for the remaining points.' } });
---
<BaseLayout title="Inline tree preview" description="Compact passive tree snapshots and numbered progression markers">
  <main class="shell inline-tree-preview">
    <div class="home-kicker">INLINE TREE PREVIEW</div><h1>Compact tree snapshots</h1>
    <p>This is the size and layout readers see inside a guide. Try the numbered markers, expand the tree, or open the picker to adjust the selection and crop. Demo changes last until reload.</p>
    <div class="guide-content"><h2>Act 1 progression</h2><p>Pick up your gems, then take the early passives in this order.</p><TreeSnapshotDemo initial={snapshot} respecBefore={respecBefore} respecAfter={respecAfter} client:load /><p>Continue toward the next waypoint once your links and passive points are ready.</p></div>
  </main>
</BaseLayout>
<style>
  .inline-tree-preview { padding-top: 24px; padding-bottom: 50px; }
  h1 { color: var(--bright); font-size: 36px; font-weight: 700; margin: 8px 0 12px; }
  main > p { max-width: 850px; color: #98a6b4; font-size: 15px; line-height: 1.6; }
  .guide-content { max-width: 1100px; }
  :global(.snapshot-demo-edit) { margin: 9px 0 0; border: 1px solid #35404b; background: #151c24; color: var(--link); padding: 5px 9px; border-radius: 4px; font-size: 13px; cursor: pointer; }
</style>
