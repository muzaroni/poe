---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LibrarySidebar from '../../components/LibrarySidebar.astro';
import { tools } from '../../data/tools';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<BaseLayout title="Tools" description="Interactive Path of Exile tools by Muzaroni">
  <div class="shell library-shell">
  <LibrarySidebar />
  <main class="tools-home">
    <h1>Path of Exile Tools</h1>
    <p>Search helpers and interactive resources.</p>
    <div class="tools-grid">
      {tools.map(tool => <a class="tool-card" href={`${base}${tool.path}`}><h2>{tool.title} <span aria-hidden="true">↗</span></h2><p>{tool.description}</p></a>)}
    </div>
  </main>
  </div>
</BaseLayout>
